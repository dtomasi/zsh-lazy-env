{"version":3,"term":{"cols":105,"rows":34,"type":"xterm-256color","theme":{"fg":"#c5cff4","bg":"#303446","palette":"#51566d:#e78284:#a6d189:#e5c890:#8caaee:#f4b8e4:#81c8be:#b5bfe2:#626880:#e78284:#a6d189:#e5c890:#8caaee:#f4b8e4:#81c8be:#a5adce"}},"timestamp":1760647545,"command":"zsh --rcs -c 'export ZDOTDIR=\"/var/folders/lw/p5bzd7k57gd0cc57qqvkfgnr0000gn/T/tmp.llmJsJF909\"; exec zsh'","title":"zsh-lazy-env: Directory-based Secret Management","env":{"SHELL":"/bin/zsh"}}
[0.618339, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000147, "o", "Starting zsh-lazy-env demo...\r\n\r\n"]
[0.002684, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.00019, "o", "\u001b[0;34m╔════════════════════════════════════════════════╗\u001b[0m\r\n"]
[0.000007, "o", "\u001b[0;34m║              [>] zsh-lazy-env Demo              ║\u001b[0m\r\n\u001b[0;34m║           On-demand variable loading           ║\u001b[0m\r\n"]
[0.000024, "o", "\u001b[0;34m╚════════════════════════════════════════════════╝\u001b[0m\r\n"]
[0.000007, "o", "\u001b[0;34m[DEMO]\u001b[0m This demo shows how variables are loaded only when needed\r\n"]
[0.000022, "o", "We'll demonstrate lazy loading for:\r\n• Simple variables (lazy_var)\r\n• Command triggers (lazy_command)\r\n"]
[0.000005, "o", "• Directory triggers (lazy_directory)\r\n"]
[0.000017, "o", "\r\n\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.009767, "o", "\r\n\r\n\u001b[0;36m> Loading zsh-lazy-env plugin\u001b[0m\r\n"]
[0.001667, "o", "\r\n\u001b[0;32m[+]\u001b[0m Plugin loaded\r\n"]
[0.000006, "o", "\r\n"]
[0.00006, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.00803, "o", "\r\n\r\n\u001b[0;36m> Part 1: Basic Variable Configuration\u001b[0m\r\nLet's configure 3 different variables:\r\n\r\n"]
[0.000036, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n"]
[0.000073, "o", "\u001b[0;35mlazy_var 'API_TOKEN' 'echo \"secret-api-token-abc123\"'\u001b[0m\r\n"]
[0.001945, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_var 'DATABASE_URL' 'echo \"postgresql://localhost:5432/myapp\"'\u001b[0m\r\n"]
[0.000099, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_var 'AWS_SECRET' 'echo \"aws-secret-key-xyz789\"'\u001b[0m\r\n"]
[0.000105, "o", "\r\n\u001b[0;32m[+]\u001b[0m 3 variables configured\r\n"]
[0.000015, "o", "\r\n"]
[0.000042, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.00655, "o", "\r\n\r\n\u001b[0;36m> Check current state - no variables loaded yet\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m lazy_list_vars\r\n\r\n"]
[0.000026, "o", "NAME                           STATUS       DIRECTORY\r\n----                           ------       ---------\r\n"]
[0.001022, "o", "API_TOKEN                      registered   global\r\n"]
[0.000986, "o", "AWS_SECRET                     registered   global\r\n"]
[0.001098, "o", "DATABASE_URL                   registered   global\r\n"]
[0.000104, "o", "\r\n\u001b[1;33m[i]\u001b[0m Notice: All variables show 'registered' status\r\n"]
[0.000016, "o", "\r\n"]
[0.000029, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.008299, "o", "\r\n\r\n\u001b[0;36m> Now let's access API_TOKEN - this will trigger loading\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m echo \"API_TOKEN: $API_TOKEN\"\r\n"]
[0.000018, "o", "\r\n"]
[0.021869, "o", "API_TOKEN: secret-api-token-abc123\r\n"]
[0.000043, "o", "\r\n\u001b[0;32m[+]\u001b[0m API_TOKEN loaded on first access!\r\n\r\n\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.01127, "o", "\r\n\r\n\u001b[0;36m> Check state again - see what changed\u001b[0m\r\n"]
[0.000033, "o", "\r\n\u001b[1;33mCommand:\u001b[0m lazy_list_vars\r\n\r\n"]
[0.000071, "o", "NAME                           STATUS       DIRECTORY\r\n----                           ------       ---------\r\n"]
[0.001976, "o", "API_TOKEN                      loaded       global\r\n"]
[0.001357, "o", "AWS_SECRET                     registered   global\r\n"]
[0.001225, "o", "DATABASE_URL                   registered   global\r\n"]
[0.000102, "o", "\r\n\u001b[1;33m[i]\u001b[0m Notice: Only API_TOKEN is now loaded, others remain registered\r\n"]
[0.000009, "o", "\r\n"]
[0.00005, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.008388, "o", "\r\n\r\n\u001b[0;36m> Let's access all variables to see them load\u001b[0m\r\n"]
[0.000035, "o", "\r\n\u001b[1;33mCommand:\u001b[0m echo \"DATABASE_URL: $DATABASE_URL\" && echo \"AWS_SECRET: $AWS_SECRET\"\r\n\r\n"]
[0.047566, "o", "DATABASE_URL: postgresql://localhost:5432/myapp\r\nAWS_SECRET: aws-secret-key-xyz789\r\n\r\n\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.010628, "o", "\r\n\r\n\u001b[0;36m> Final state check\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m lazy_list_vars\r\n\r\n"]
[0.00003, "o", "NAME                           STATUS       DIRECTORY\r\n----                           ------       ---------\r\n"]
[0.00185, "o", "API_TOKEN                      loaded       global\r\n"]
[0.001313, "o", "AWS_SECRET                     loaded       global\r\n"]
[0.001181, "o", "DATABASE_URL                   loaded       global\r\n"]
[0.000081, "o", "\r\n\u001b[1;33m[i]\u001b[0m Now all variables are loaded and show their values\r\n"]
[0.000008, "o", "\r\n"]
[0.000039, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.015172, "o", "\r\n\r\n\u001b[0;36m> Part 2: Command-Triggered Loading\u001b[0m\r\nVariables can auto-load when specific commands are executed:\r\n\r\n"]
[0.000028, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_var 'DOCKER_TOKEN' 'echo \"docker-registry-token-def456\"'\u001b[0m\r\n"]
[0.000184, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_var 'K8S_CONFIG' 'echo \"kubernetes-config-ghi789\"'\u001b[0m\r\n"]
[0.000079, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_command 'docker' 'DOCKER_TOKEN'\u001b[0m\r\n"]
[0.000068, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_command 'pattern:kubectl.*' 'K8S_CONFIG'\u001b[0m\r\n"]
[0.000066, "o", "\r\n\u001b[0;32m[+]\u001b[0m Command triggers configured\r\n"]
[0.000005, "o", "\r\n"]
[0.000026, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.014088, "o", "\r\n\r\n\u001b[0;36m> Check state - new variables are not loaded\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m lazy_list_vars\r\n\r\n"]
[0.000032, "o", "NAME                           STATUS       DIRECTORY\r\n"]
[0.000008, "o", "----                           ------       ---------\r\n"]
[0.001815, "o", "API_TOKEN                      loaded       global\r\n"]
[0.001216, "o", "AWS_SECRET                     loaded       global\r\n"]
[0.001165, "o", "DATABASE_URL                   loaded       global\r\n"]
[0.001348, "o", "DOCKER_TOKEN                   registered   global\r\n"]
[0.001024, "o", "K8S_CONFIG                     registered   global\r\n"]
[0.000063, "o", "\r\n\u001b[1;33m[i]\u001b[0m DOCKER_TOKEN and K8S_CONFIG show 'registered'\r\n"]
[0.000008, "o", "\r\n"]
[0.00006, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.016478, "o", "\r\n\r\n\u001b[0;36m> Execute 'docker' command - this will auto-load DOCKER_TOKEN\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m docker --version || echo \"Docker command executed\"\r\n\r\n"]
[0.058896, "o", "Docker version 28.5.1, build e180ab8ab8\r\n"]
[0.000674, "o", "DOCKER_TOKEN is now loaded: docker-registry-token-def456\r\n"]
[0.000008, "o", "\r\n"]
[0.000026, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.009482, "o", "\r\n\r\n\u001b[0;36m> Execute 'kubectl' command - this will auto-load K8S_CONFIG\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m kubectl version || echo \"Kubectl command executed\"\r\n"]
[0.000014, "o", "\r\n"]
[0.204802, "o", "Client Version: v1.34.1\r\nKustomize Version: v5.7.1\r\n"]
[0.000744, "o", "Kubectl command executed\r\n"]
[0.000054, "o", "K8S_CONFIG is now loaded: kubernetes-config-ghi789\r\n"]
[0.000023, "o", "\r\n"]
[0.000022, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.0112, "o", "\r\n\r\n\u001b[0;36m> Check final state\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m lazy_list_vars\r\n\r\n"]
[0.000015, "o", "NAME                           STATUS       DIRECTORY\r\n"]
[0.000048, "o", "----                           ------       ---------\r\n"]
[0.000876, "o", "API_TOKEN                      loaded       global\r\n"]
[0.000623, "o", "AWS_SECRET                     loaded       global\r\n"]
[0.000622, "o", "DATABASE_URL                   loaded       global\r\n"]
[0.000558, "o", "DOCKER_TOKEN                   loaded       global\r\n"]
[0.000596, "o", "K8S_CONFIG                     loaded       global\r\n"]
[0.000101, "o", "\r\n\u001b[1;33m[i]\u001b[0m Both command-triggered variables are now loaded\r\n"]
[0.000043, "o", "\r\n"]
[0.00005, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.007493, "o", "\r\n\r\n\u001b[0;36m> Part 3: Directory-Triggered Loading\u001b[0m\r\nVariables can auto-load when entering specific directories:\r\n\r\n"]
[0.013037, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_var 'PROJECT_A_KEY' 'echo \"project-a-secret-jkl012\"'\u001b[0m\r\n"]
[0.000134, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_var 'PROJECT_B_KEY' 'echo \"project-b-secret-mno345\"'\u001b[0m\r\n"]
[0.000062, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_var 'STAGING_DB' 'echo \"staging-database-url-pqr678\"'\u001b[0m\r\n"]
[0.000053, "o", "\r\n"]
[0.000006, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n"]
[0.000004, "o", "\u001b[0;35mlazy_directory '/tmp/demo-project-a' 'PROJECT_A_KEY'\u001b[0m\r\n"]
[0.00006, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_directory '/tmp/demo-project-b' 'PROJECT_B_KEY'\u001b[0m\r\n"]
[0.000045, "o", "\r\n\u001b[0;90m# Add to ~/.zshrc\u001b[0m\r\n\u001b[0;35mlazy_directory 'pattern:.*staging.*' 'STAGING_DB'\u001b[0m\r\n"]
[0.000051, "o", "\r\n\u001b[0;32m[+]\u001b[0m Directory triggers configured\r\n"]
[0.000019, "o", "\r\n\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.010828, "o", "\r\n\r\n\u001b[0;36m> Check state - directory variables not loaded\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m lazy_list_vars\r\n\r\n"]
[0.000028, "o", "NAME                           STATUS       DIRECTORY\r\n"]
[0.000005, "o", "----                           ------       ---------\r\n"]
[0.001801, "o", "API_TOKEN                      loaded       global\r\n"]
[0.001134, "o", "AWS_SECRET                     loaded       global\r\n"]
[0.000993, "o", "DATABASE_URL                   loaded       global\r\n"]
[0.000957, "o", "DOCKER_TOKEN                   loaded       global\r\n"]
[0.000978, "o", "K8S_CONFIG                     loaded       global\r\n"]
[0.000985, "o", "PROJECT_A_KEY                  registered   global\r\n"]
[0.000959, "o", "PROJECT_B_KEY                  registered   global\r\n"]
[0.000947, "o", "STAGING_DB                     registered   global\r\n"]
[0.000059, "o", "\r\n\u001b[1;33m[i]\u001b[0m PROJECT_A_KEY, PROJECT_B_KEY, and STAGING_DB show 'registered'\r\n"]
[0.000009, "o", "\r\n"]
[0.000029, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.008848, "o", "\r\n\r\n\u001b[0;36m> Change to /tmp/demo-project-a - this will auto-load PROJECT_A_KEY\u001b[0m\r\n"]
[0.000031, "o", "\r\n\u001b[1;33mCommand:\u001b[0m cd /tmp/demo-project-a\r\n\r\n"]
[0.032545, "o", "\r\n\u001b[1;33m[i]\u001b[0m Current directory: /tmp/demo-project-a\r\n"]
[0.000005, "o", "PROJECT_A_KEY is now auto-loaded: project-a-secret-jkl012\r\n"]
[0.000012, "o", "\r\n"]
[0.00005, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.011348, "o", "\r\n\r\n\u001b[0;36m> Check state after directory change\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m lazy_list_vars\r\n\r\n"]
[0.000094, "o", "NAME                           STATUS       DIRECTORY\r\n----                           ------       ---------\r\n"]
[0.001978, "o", "API_TOKEN                      loaded       global\r\n"]
[0.001362, "o", "AWS_SECRET                     loaded       global\r\n"]
[0.001073, "o", "DATABASE_URL                   loaded       global\r\n"]
[0.001007, "o", "DOCKER_TOKEN                   loaded       global\r\n"]
[0.001047, "o", "K8S_CONFIG                     loaded       global\r\n"]
[0.001039, "o", "PROJECT_A_KEY                  loaded       global\r\n"]
[0.000926, "o", "PROJECT_B_KEY                  registered   global\r\n"]
[0.00079, "o", "STAGING_DB                     registered   global\r\n"]
[0.000065, "o", "\r\n\u001b[1;33m[i]\u001b[0m PROJECT_A_KEY is now loaded due to directory trigger\r\n"]
[0.000032, "o", "\r\n\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.008598, "o", "\r\n\r\n\u001b[0;36m> Change to /tmp/demo-staging - this will trigger pattern match\u001b[0m\r\n"]
[0.00002, "o", "\r\n\u001b[1;33mCommand:\u001b[0m cd /tmp/demo-staging\r\n\r\n"]
[0.036381, "o", "\r\n\u001b[1;33m[i]\u001b[0m Current directory: /tmp/demo-staging\r\nSTAGING_DB is now loaded via pattern: staging-database-url-pqr678\r\n"]
[0.000008, "o", "\r\n"]
[0.000011, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.008841, "o", "\r\n\r\n\u001b[0;36m> Check final state\u001b[0m\r\n\r\n\u001b[1;33mCommand:\u001b[0m lazy_list_vars\r\n\r\n"]
[0.000017, "o", "NAME                           STATUS       DIRECTORY\r\n"]
[0.000026, "o", "----                           ------       ---------\r\n"]
[0.001069, "o", "API_TOKEN                      loaded       global\r\n"]
[0.000804, "o", "AWS_SECRET                     loaded       global\r\n"]
[0.00072, "o", "DATABASE_URL                   loaded       global\r\n"]
[0.000665, "o", "DOCKER_TOKEN                   loaded       global\r\n"]
[0.000645, "o", "K8S_CONFIG                     loaded       global\r\n"]
[0.000634, "o", "PROJECT_A_KEY                  loaded       global\r\n"]
[0.000622, "o", "PROJECT_B_KEY                  registered   global\r\n"]
[0.000682, "o", "STAGING_DB                     loaded       global\r\n"]
[0.000053, "o", "\r\n\u001b[1;33m[i]\u001b[0m STAGING_DB is now loaded due to directory pattern match\r\n\r\n"]
[0.000015, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.011675, "o", "\r\n\r\n\u001b[0;36m> Cleaning up demo directories\u001b[0m\r\n"]
[0.031158, "o", "\r\n\u001b[0;32m[+]\u001b[0m Demo directories removed\r\n\r\n"]
[0.000086, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.010041, "o", "\r\n\r\n\u001b[0;36m> Summary\u001b[0m\r\nzsh-lazy-env provides three loading mechanisms:\r\n\r\n[+] lazy_var: Define variables that load on first access\r\n"]
[0.000011, "o", "[+] lazy_command: Auto-load when specific commands run\r\n[+] lazy_directory: Auto-load when entering directories\r\n\r\n"]
[0.000068, "o", "\r\n\u001b[1;33m[i]\u001b[0m Variables only load when needed - saving time and resources\r\n\r\n"]
[0.000037, "o", "\u001b[0;90m────────────────────────────────────────────────\u001b[0m\r\n"]
[3.013336, "o", "\r\n\u001b[0;32m[!] Demo complete! Thanks for trying zsh-lazy-env!\u001b[0m\r\n"]
[0.000018, "o", "\u001b[0;36mVisit github.com/dtomasi/zsh-lazy-env for more information\u001b[0m\r\n"]
[0.003551, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                        \r \r"]
[0.009559, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J\u001b[34mdemo\u001b[39m \u001b[32m/tmp\u001b[39m \u001b[33m$\u001b[39m \u001b[K\u001b[?2004h"]
[8.178992, "o", "\u001b[?2004l\r\r\n"]
[0.004979, "x", "0"]
